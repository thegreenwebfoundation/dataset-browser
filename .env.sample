# Copy this file to .env and fill in the values.
#
# Only the recipes that talk to the foundation's object storage need these
# (daily_snapshot / all_dataset_dbs / release) — refreshing and browsing the
# real time cloud dataset works without them.

# The name of your mcli alias configured with credentials for the
# foundation's object storage (see: mcli alias set).
# Using an alias with MinIO allows us to work with different object
# storage services.
MINIO_ALIAS="the-alias-used-by-minio"

# The bucket holding the nightly green domains snapshots.
BUCKET_NAME="tgwf-green-domains-live"

# Bucket used by the wider dataset pipeline. Not used by any local recipe —
# the deploy playbook passes it through to the server's shared .env.
RTC_BUCKET_NAME="rtc-bucket-used-by-infra"
